{
  "version": "1.0",
  "ai": {
    "provider": "deepseek",
    "model": "deepseek-v4-flash",
    "base_url": "https://api.deepseek.com",
    "api_key_env": "DEEPSEEK_API_KEY",
    "temperature": 0.3,
    "max_tokens": 4096,
    "throttle_sec": 0,
    "languages": [
      "zh"
    ],
    "analysis_concurrency": 5,
    "enrichment_concurrency": 5,
    "thinking_enabled": false
  },
  "sources": {
    "github": [
      {
        "type": "user_events",
        "username": "karpathy",
        "enabled": true
      },
      {
        "type": "repo_releases",
        "owner": "vllm-project",
        "repo": "vllm",
        "enabled": true
      },
      {
        "type": "repo_releases",
        "owner": "sgl-project",
        "repo": "sglang",
        "enabled": true
      },
      {
        "type": "repo_releases",
        "owner": "triton-lang",
        "repo": "triton",
        "enabled": true
      }
    ],
    "hackernews": {
      "enabled": true,
      "fetch_top_stories": 30,
      "min_score": 150
    },
    "rss": [
      {
        "name": "Simon Willison",
        "url": "https://simonwillison.net/atom/everything/",
        "enabled": true,
        "category": "ai-tools"
      },
      {
        "name": "36氪 - 文章资讯",
        "url": "https://36kr.com/feed-article",
        "enabled": true,
        "category": "business-consumer"
      },
      {
        "name": "GitHub Trending - Daily",
        "url": "https://mshibanami.github.io/GitHubTrendingRSS/daily/all.xml",
        "enabled": true,
        "category": "github-trending"
      },
      {
        "name": "Semianalysis",
        "url": "https://newsletter.semianalysis.com/feed",
        "enabled": true,
        "category": "semiconductors"
      },
      {
        "name": "BBC World",
        "url": "https://feeds.bbci.co.uk/news/world/rss.xml",
        "enabled": true,
        "category": "macro-global",
        "source_tier": "professional",
        "preferred": true
      },
      {
        "name": "BBC Business",
        "url": "https://feeds.bbci.co.uk/news/business/rss.xml",
        "enabled": true,
        "category": "macro-economy",
        "source_tier": "professional",
        "preferred": true
      },
      {
        "name": "BBC Technology",
        "url": "https://feeds.bbci.co.uk/news/technology/rss.xml",
        "enabled": true,
        "category": "technology",
        "source_tier": "professional",
        "preferred": true
      },
      {
        "name": "LWN.net",
        "url": "https://lwn.net/headlines/full_text?key=${LWN_KEY}",
        "enabled": false,
        "category": "linux-kernel"
      }
    ],
    "reddit": {
      "enabled": true,
      "subreddits": [
        {
          "subreddit": "smallbusiness",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 10,
          "min_score": 5,
          "category": "business-pain"
        },
        {
          "subreddit": "Entrepreneur",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 10,
          "min_score": 5,
          "category": "business-pain"
        },
        {
          "subreddit": "digitalnomad",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 10,
          "min_score": 5,
          "category": "travel-work"
        },
        {
          "subreddit": "languagelearning",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 10,
          "min_score": 5,
          "category": "education"
        },
        {
          "subreddit": "photography",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 10,
          "min_score": 5,
          "category": "creator-tools"
        }
      ],
      "users": [],
      "fetch_comments": 10
    },
    "telegram": {
      "enabled": false,
      "channels": []
    },
    "twitter": {
      "enabled": false,
      "users": []
    },
    "openbb": {
      "enabled": false,
      "watchlists": []
    },
    "ossinsight": {
      "enabled": true,
      "period": "past_24_hours",
      "languages": ["All", "Python", "TypeScript", "Swift"],
      "keywords": [],
      "min_stars": 5,
      "max_items": 15,
      "category": "github-trending"
    },
    "google_news": {
      "enabled": true,
      "query": "消费趋势 OR 新产品 OR 小微企业 OR 创业机会",
      "language": "zh-CN",
      "country": "CN",
      "ceid": "CN:zh-Hans",
      "max_results": 30,
      "category": "business-consumer",
      "queries": [
        {
          "name": "中国官方数据与政策",
          "query": "(site:gov.cn OR site:stats.gov.cn OR site:pbc.gov.cn OR site:miit.gov.cn OR site:customs.gov.cn) (经济 OR 政策 OR 数据 OR 监管)",
          "max_results": 18,
          "category": "macro-policy",
          "source_tier": "official"
        },
        {
          "name": "新华社",
          "query": "(site:news.cn OR site:xinhuanet.com) (中国 OR 国际 OR 经济 OR 科技 OR 社会)",
          "max_results": 16,
          "category": "macro-policy",
          "source_tier": "official",
          "preferred": true,
          "publisher_allowlist": ["新华", "Xinhua"]
        },
        {
          "name": "澎湃与联合早报",
          "query": "(site:thepaper.cn OR site:zaobao.com.sg) (中国 OR 国际 OR 经济 OR 政策 OR 科技 OR 社会)",
          "max_results": 24,
          "category": "policy-society",
          "source_tier": "professional",
          "preferred": true,
          "publisher_allowlist": ["澎湃", "联合早报", "Zaobao"]
        },
        {
          "name": "BBC 与 CNN",
          "query": "(site:bbc.com/news OR site:cnn.com) (China OR economy OR business OR technology OR policy)",
          "language": "en-US",
          "country": "US",
          "ceid": "US:en",
          "max_results": 20,
          "category": "macro-global",
          "source_tier": "professional",
          "preferred": true,
          "publisher_allowlist": ["BBC", "CNN"]
        },
        {
          "name": "朝日新闻",
          "query": "site:asahi.com (日本 OR 中国 OR 経済 OR 政治 OR 技術)",
          "language": "ja",
          "country": "JP",
          "ceid": "JP:ja",
          "max_results": 12,
          "category": "macro-global",
          "source_tier": "professional",
          "preferred": true,
          "publisher_allowlist": ["朝日", "Asahi"]
        },
        {
          "name": "商业消费与创业变化",
          "query": "消费趋势 OR 新产品 OR 小微企业 OR 创业机会",
          "max_results": 20,
          "category": "business-consumer",
          "source_tier": "professional"
        }
      ]
    }
  },
  "filtering": {
    "ai_score_threshold": 8.0,
    "time_window_hours": 24
  },
  "startup_radar": {
    "enabled": true,
    "profile_path": "profile.yml",
    "database_path": "data/startup_radar.db",
    "output_dir": "data/radar",
    "docs_posts_dir": "docs/_posts",
    "prompt_version": "startup-radar-v5",
    "min_score": 65,
    "max_raw_items": 200,
    "prefilter_max_items": 60,
    "triage_enabled": true,
    "triage_batch_size": 15,
    "triage_excerpt_chars": 320,
    "triage_max_tokens": 2500,
    "triage_concurrency": 2,
    "local_score_weight": 0.20,
    "selection_audit": true,
    "max_articles_per_run": 20,
    "source_quotas": {
      "reddit": 0.05,
      "rss": 0.40,
      "google_news": 0.40,
      "hackernews": 0.10,
      "developer": 0.05
    },
    "max_opportunities": 3,
    "max_signals": 5,
    "max_skips": 3,
    "opportunity_cooldown_days": 7,
    "extract_full_text": true,
    "extractor_concurrency": 5,
    "min_content_chars": 1200
  },
  "news_digest": {
    "enabled": true,
    "output_dir": "data/news",
    "docs_posts_dir": "docs/_posts",
    "prompt_version": "news-digest-v1",
    "max_input_items": 40,
    "max_events": 6,
    "max_items_per_publisher": 6,
    "community_max_ratio": 0.05,
    "excerpt_chars": 320,
    "max_output_tokens": 8000,
    "categories": ["宏观经济", "政策监管", "产业公司", "科技产品", "消费社会"],
    "preferred_publishers": ["新华社", "新华网", "澎湃新闻", "联合早报", "BBC", "CNN", "朝日新闻", "朝日新聞"]
  },
  "webhook": {
    "enabled": false,
    "url_env": "HORIZON_WEBHOOK_URL",
    "delivery": "summary_and_items",
    "overview_position": "last",
    "platform": "feishu",
    "layout": "collapsible",
    "fallback_layout": "markdown",
    "languages": [
      "zh"
    ],
    "request_body": {
      "msg_type": "interactive",
      "card": {
        "schema": "2.0",
        "config": {
          "wide_screen_mode": true
        },
        "header": {
          "title": {
            "tag": "plain_text",
            "content": "#{message_title}"
          },
          "template": "blue"
        },
        "body": {
          "elements": [
            {
              "tag": "markdown",
              "content": "#{summary}"
            }
          ]
        }
      }
    },
    "headers": ""
  }
}
