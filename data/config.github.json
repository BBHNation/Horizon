{
  "version": "1.0",
  "ai": {
    "provider": "deepseek",
    "model": "deepseek-v4-flash",
    "base_url": "https://api.deepseek.com",
    "api_key_env": "DEEPSEEK_API_KEY",
    "temperature": 0.3,
    "max_tokens": 4096,
    "throttle_sec": 0,
    "languages": [
      "zh"
    ],
    "analysis_concurrency": 5,
    "enrichment_concurrency": 5
  },
  "sources": {
    "github": [
      {
        "type": "user_events",
        "username": "karpathy",
        "enabled": true
      },
      {
        "type": "repo_releases",
        "owner": "vllm-project",
        "repo": "vllm",
        "enabled": true
      },
      {
        "type": "repo_releases",
        "owner": "sgl-project",
        "repo": "sglang",
        "enabled": true
      },
      {
        "type": "repo_releases",
        "owner": "triton-lang",
        "repo": "triton",
        "enabled": true
      }
    ],
    "hackernews": {
      "enabled": true,
      "fetch_top_stories": 30,
      "min_score": 150
    },
    "rss": [
      {
        "name": "Simon Willison",
        "url": "https://simonwillison.net/atom/everything/",
        "enabled": true,
        "category": "ai-tools"
      },
      {
        "name": "36氪 - 文章资讯",
        "url": "https://36kr.com/feed-article",
        "enabled": true,
        "category": "business-consumer"
      },
      {
        "name": "GitHub Trending - Daily",
        "url": "https://mshibanami.github.io/GitHubTrendingRSS/daily/all.xml",
        "enabled": true,
        "category": "github-trending"
      },
      {
        "name": "Semianalysis",
        "url": "https://newsletter.semianalysis.com/feed",
        "enabled": true,
        "category": "semiconductors"
      },
      {
        "name": "LWN.net",
        "url": "https://lwn.net/headlines/full_text?key=${LWN_KEY}",
        "enabled": false,
        "category": "linux-kernel"
      }
    ],
    "reddit": {
      "enabled": true,
      "subreddits": [
        {
          "subreddit": "smallbusiness",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 10,
          "min_score": 5,
          "category": "business-pain"
        },
        {
          "subreddit": "Entrepreneur",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 10,
          "min_score": 5,
          "category": "business-pain"
        },
        {
          "subreddit": "digitalnomad",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 10,
          "min_score": 5,
          "category": "travel-work"
        },
        {
          "subreddit": "languagelearning",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 10,
          "min_score": 5,
          "category": "education"
        },
        {
          "subreddit": "photography",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 10,
          "min_score": 5,
          "category": "creator-tools"
        }
      ],
      "users": [],
      "fetch_comments": 10
    },
    "telegram": {
      "enabled": false,
      "channels": []
    },
    "twitter": {
      "enabled": false,
      "users": []
    },
    "openbb": {
      "enabled": false,
      "watchlists": []
    },
    "ossinsight": {
      "enabled": true,
      "period": "past_24_hours",
      "languages": ["All", "Python", "TypeScript", "Swift"],
      "keywords": [],
      "min_stars": 5,
      "max_items": 15,
      "category": "github-trending"
    },
    "google_news": {
      "enabled": true,
      "query": "消费趋势 OR 新产品 OR 小微企业 OR 创业机会",
      "language": "zh-CN",
      "country": "CN",
      "ceid": "CN:zh-Hans",
      "max_results": 30,
      "category": "business-consumer"
    }
  },
  "filtering": {
    "ai_score_threshold": 8.0,
    "time_window_hours": 24
  },
  "startup_radar": {
    "enabled": true,
    "profile_path": "profile.yml",
    "database_path": "data/startup_radar.db",
    "output_dir": "data/radar",
    "docs_posts_dir": "docs/_posts",
    "prompt_version": "startup-radar-v5",
    "min_score": 65,
    "max_raw_items": 200,
    "prefilter_max_items": 60,
    "triage_enabled": true,
    "triage_batch_size": 15,
    "triage_excerpt_chars": 320,
    "triage_max_tokens": 2500,
    "triage_concurrency": 2,
    "local_score_weight": 0.20,
    "selection_audit": true,
    "max_articles_per_run": 20,
    "source_quotas": {
      "reddit": 0.30,
      "rss": 0.30,
      "google_news": 0.20,
      "hackernews": 0.15,
      "developer": 0.05
    },
    "max_opportunities": 3,
    "max_signals": 5,
    "max_skips": 3,
    "opportunity_cooldown_days": 7,
    "extract_full_text": true,
    "extractor_concurrency": 5,
    "min_content_chars": 1200
  },
  "webhook": {
    "enabled": false,
    "url_env": "HORIZON_WEBHOOK_URL",
    "delivery": "summary_and_items",
    "overview_position": "last",
    "platform": "feishu",
    "layout": "collapsible",
    "fallback_layout": "markdown",
    "languages": [
      "zh"
    ],
    "request_body": {
      "msg_type": "interactive",
      "card": {
        "schema": "2.0",
        "config": {
          "wide_screen_mode": true
        },
        "header": {
          "title": {
            "tag": "plain_text",
            "content": "#{message_title}"
          },
          "template": "blue"
        },
        "body": {
          "elements": [
            {
              "tag": "markdown",
              "content": "#{summary}"
            }
          ]
        }
      }
    },
    "headers": ""
  }
}
